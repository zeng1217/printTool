{
  "$schema": "https://schema.tauri.app/config/2",
  "identifier": "default",
  "description": "主窗口与标签预览窗口默认权限",
  "windows": ["main", "label"],
  "permissions": [
    "core:default",
    "core:webview:allow-create-webview-window",
    "core:window:allow-set-focus",
    "sql:default",
    "sql:allow-load",
    "sql:allow-execute",
    "sql:allow-select",
    "sql:allow-close",
    "shell:default",
    "shell:allow-open"
  ]
}
